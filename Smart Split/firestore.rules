rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if user is the document owner
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    // Users collection
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update, delete: if isOwner(userId);
    }
    
    // Friends collection
    match /friends/{friendId} {
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.friendId);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.friendId);
      allow delete: if isAuthenticated() && 
        (request.auth.uid == resource.data.userId || 
         request.auth.uid == resource.data.friendId);
    }
    
    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.get('memberIds', []);
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.createdBy;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.get('memberIds', []);
      allow delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }
    
    // Expenses collection
    match /expenses/{expenseId} {
      // Helper function to check if user is member of expense's group
      function isGroupMember() {
        let groupId = resource.data.groupId;
        return groupId != null && groupId != '' &&
               exists(/databases/$(database)/documents/groups/$(groupId)) &&
               request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.get('memberIds', []);
      }
      
      allow read: if isAuthenticated() && 
        (request.auth.uid == resource.data.payerId || 
         request.auth.uid in resource.data.participants ||
         isGroupMember());
      allow create: if isAuthenticated() && 
        (request.auth.uid == request.resource.data.payerId || 
         request.auth.uid in request.resource.data.participants);
      allow update, delete: if isAuthenticated() && request.auth.uid == resource.data.createdBy;
    }
  }
}