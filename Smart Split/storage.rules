rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Users can upload/manage their own profile pictures
    match /users/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Receipt images - owner only, max 5MB, images only
    match /receipts/{userId}/{fileId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null && request.auth.uid == userId
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // Group pictures - all authenticated users can read, members can write
    match /groups/{groupId}/{allPaths=**} {
      allow read: if request.auth != null;
      // For write, we'd need to check Firestore to verify membership
      // For now, allow any authenticated user (you can tighten this later)
      allow write: if request.auth != null;
    }
  }
}
